# Local dev: a plain SQLite file works out of the box.
# Production (Vercel): use a Turso database — libsql://<db-name>-<org>.turso.io?authToken=<token>
# (Turso's dashboard/CLI gives you both the URL and token; you can paste the token
# into the URL as shown above, or set TURSO_AUTH_TOKEN separately instead.)
DATABASE_URL="file:./dev.db"

# Optional if not embedding the token directly in DATABASE_URL above.
# TURSO_AUTH_TOKEN=""

# Gates /moderate — pass as ?key=... . Generate a real random value before deploying.
ADMIN_SECRET=""

# Used to build canonical URLs, sitemap.xml, and Open Graph tags.
# Set this to your real deployed URL once you have one.
NEXT_PUBLIC_SITE_URL="https://samasyanepal.vercel.app"
